# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded course content (videos/PDFs) — not committed
/storage/uploads/

# database backups (scripts/backup-db.sh) — not committed
/storage/backups/

# real client-provided course videos/images — too large for git, kept on
# disk only; the seed script reads them from here to populate storage/uploads/
/prisma/seed-data/assets/intimate-lightening/videos/
/prisma/seed-data/assets/intimate-lightening/images/

# the raw folder the client originally pasted in — its contents were already
# copied into prisma/seed-data/assets/intimate-lightening/ above; this is a
# duplicate copy and should never be committed
/Intimate lightning course/
